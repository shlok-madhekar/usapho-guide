# Supabase (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The repository content edits are proposed against
GITHUB_REPO=owner/usapho-guide

# OAuth app client id for the editor's device flow.
# Public by design: it ships in the browser bundle. The client secret is not
# used, because device flow does not need one.
NEXT_PUBLIC_GITHUB_CLIENT_ID=Ov23li...

# Optional: a maintainer's own token, to skip connecting GitHub when running
# locally. Never needed in production.
# GITHUB_TOKEN=
