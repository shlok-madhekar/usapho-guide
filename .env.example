# Supabase (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Enable the git-backed content editor. Only turn this on where the git
# checkout actually lives (local machine or your own VM), never on Vercel.
CONTENT_EDITING=on

# Video engine (Manim). Leave unset to use http://localhost:8100
# NEXT_PUBLIC_ENGINE_URL=http://localhost:8100
